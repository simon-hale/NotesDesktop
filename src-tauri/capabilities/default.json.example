{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Notes Desktop 权限清单模板（示例文件，Tauri 不会加载它，可以安全提交）。真正的 capabilities/default.json 由 src-tauri/build.rs 依据项目根目录的 .env.local 生成；要增删权限请改这里。",
  "windows": ["main", "upload"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://your-notes-backend.example.com/*" }]
    }
  ]
}
